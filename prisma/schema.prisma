generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id                String             @id @default(uuid())
  name              String
  hireDate          String             @default("")
  role              String             @default("ADMIN")
  password          String             @default("1234")
  baseSalary        Float              @default(0)
  hourlyRate        Float              @default(0)
  branch            String?
  sortOrder         Int                @default(0)
  createdAt         String             @default("")
  dismissalDate     String             @default("")
  seniorId          String?
  senior            Employee?          @relation("SeniorSubordinates", fields: [seniorId], references: [id])
  subordinates      Employee[]         @relation("SeniorSubordinates")
  kpiRecords        KpiRecord[]
  monthlyChecklists MonthlyChecklist[]
  promotionSales    PromotionSale[]
  registrationKpis  RegistrationKpi[]
  shifts            Shift[]
  roleHistory       EmployeeRoleHistory[]
  dailyChecklists   DailyChecklist[]
}

model EmployeeRoleHistory {
  id         String   @id @default(uuid())
  employeeId String
  role       String   @default("ADMIN")
  seniorId   String?
  startDate  String   // "YYYY-MM-DD"
  endDate    String?  // "YYYY-MM-DD"
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
}

model Shift {
  id            String   @id @default(uuid())
  date          String
  employeeId    String
  type          String   @default("REGULAR")
  hours         Float    @default(0)
  cabinetClosed Boolean  @default(false)
  centerClosed  Boolean  @default(false)
  isActingLead  Boolean  @default(false)
  isTrainee     Boolean  @default(false)
  coefficient   Float    @default(1.0)
  comment       String?
  createdAt     String   @default("")
  createdBy     String?
  isDeleted     Boolean  @default(false)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model KpiRecord {
  id           String   @id @default(uuid())
  date         String
  employeeId   String
  qualityScore Float    @default(0)
  errorsCount  Int      @default(0)
  salesBonus   Float    @default(0)
  checkList    Float    @default(0)
  createdAt    String   @default("")
  createdBy    String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model MonthlyNorm {
  month     String @id
  hours     Float  @default(176)
  createdAt String @default("")
}

model MonthlyChecklist {
  id               String   @id @default(uuid())
  month            String
  employeeId       String
  percentage       Float    @default(0)
  sickLeaveOpening Int      @default(0)
  sickLeaveClosing Int      @default(0)
  cardCreation     Int      @default(0)
  closingBonus     Int      @default(0)
  createdAt        String   @default("")
  updatedAt        String   @default("")
  updatedBy        String?
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([month, employeeId])
}

model PromotionSale {
  id          String   @id @default(uuid())
  date        String
  patientId   String?
  employeeId  String
  productName String
  price       Float    @default(0)
  bonus       Float    @default(0)
  createdAt   String   @default("")
  createdBy   String?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model RegistrationKpi {
  id         String   @id @default(uuid())
  date       String
  patientId  String?
  employeeId String
  criterion1 Float    @default(0)
  criterion2 Float    @default(0)
  criterion3 Float    @default(0)
  totalScore Float    @default(0)
  maxScore   Float    @default(0)
  count      Int      @default(0)
  createdAt  String   @default("")
  createdBy  String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model DailyChecklist {
  id         String   @id @default(uuid())
  date       String
  employeeId String
  criterion1 Float    @default(0) // Внешний вид и дисциплина
  criterion2 Float    @default(0) // Приветствие и первичный контакт
  criterion3 Float    @default(0) // Соблюдение алгоритма приема
  criterion4 Float    @default(0) // Стимулирование услуг
  criterion5 Float    @default(0) // Работа с возражениями
  criterion6 Float    @default(0) // Завершение контакта
  totalScore Float    @default(0)
  maxScore   Float    @default(100)
  createdAt  String   @default("")
  createdBy  String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model AuditLog {
  id            String  @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  changedBy     String
  changedByRole String
  timestamp     String
  details       String?
}

model ClosedMonth {
  month     String   @id // Format: "YYYY-MM"
  isClosed  Boolean  @default(true)
  createdAt String   @default("")
  updatedAt String   @default("")
}
